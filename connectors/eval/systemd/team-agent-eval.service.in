[Unit]
Description=Team agent connector eval: еженедельный eval ответов с LLM-судьёй
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=@AGENT_USER@
WorkingDirectory=@AGENT_HOME@
EnvironmentFile=@AGENT_USER_HOME@/.claude-token.env
Environment=AGENT_HOME=@AGENT_HOME@
Environment=TZ=@TZ@
Environment=PATH=@AGENT_USER_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash @AGENT_HOME@/connectors/eval/run_eval.sh
# бэкстоп: EVAL_SIZE вопросов × (ответ до 600 с + судья до 240 с)
TimeoutStartSec=14400
NoNewPrivileges=true
