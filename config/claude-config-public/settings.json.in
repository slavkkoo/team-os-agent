{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Read(/@AGENT_HOME@/knowledge/**)",
      "Grep(/@AGENT_HOME@/knowledge/**)",
      "Glob(/@AGENT_HOME@/knowledge/**)"
    ],
    "deny": [
      "Write(/@AGENT_HOME@/knowledge/**)",
      "Edit(/@AGENT_HOME@/knowledge/**)",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Read(/@AGENT_HOME@/.env*)",
      "Read(/@AGENT_HOME@/code/**)",
      "Read(/@AGENT_HOME@/memory/**)",
      "Read(/@AGENT_HOME@/logs/**)",
      "Read(/@AGENT_HOME@/uploads/**)",
      "Read(/@AGENT_HOME@/*_run/**)",
      "Read(/@AGENT_HOME@/tg/**)",
      "Read(/@AGENT_HOME@/.venv/**)",
      "Read(/@AGENT_HOME@/.claude-config/**)",
      "Read(/@AGENT_HOME@/.claude-config-public/**)",
      "Read(/@AGENT_HOME@/bin/**)",
      "Read(/@AGENT_HOME@/prompts/**)",
      "Read(/@AGENT_HOME@/config/**)",
      "Read(/@AGENT_HOME@/.git/**)",
      "Read(/@AGENT_HOME@/*.json)",
      "Read(/@AGENT_HOME@/*.txt)",
      "Read(/@AGENT_HOME@/*.md)",
      "Read(/@AGENT_USER_HOME@/.claude-token.env)",
      "Read(/@AGENT_USER_HOME@/.ssh/**)",
      "Read(//root/**)",
      "Read(//etc/**)",
      "Grep(/@AGENT_HOME@/.env*)",
      "Grep(/@AGENT_HOME@/code/**)",
      "Grep(/@AGENT_HOME@/memory/**)",
      "Grep(/@AGENT_HOME@/logs/**)",
      "Grep(/@AGENT_HOME@/uploads/**)",
      "Grep(/@AGENT_HOME@/*_run/**)",
      "Grep(/@AGENT_HOME@/tg/**)",
      "Grep(/@AGENT_HOME@/.venv/**)",
      "Grep(/@AGENT_HOME@/.claude-config/**)",
      "Grep(/@AGENT_HOME@/.claude-config-public/**)",
      "Grep(/@AGENT_HOME@/bin/**)",
      "Grep(/@AGENT_HOME@/prompts/**)",
      "Grep(/@AGENT_HOME@/config/**)",
      "Grep(/@AGENT_HOME@/.git/**)",
      "Grep(/@AGENT_HOME@/*.json)",
      "Grep(/@AGENT_HOME@/*.txt)",
      "Grep(/@AGENT_HOME@/*.md)",
      "Grep(/@AGENT_USER_HOME@/.claude-token.env)",
      "Grep(/@AGENT_USER_HOME@/.ssh/**)",
      "Grep(//root/**)",
      "Grep(//etc/**)",
      "Glob(/@AGENT_HOME@/.env*)",
      "Glob(/@AGENT_HOME@/code/**)",
      "Glob(/@AGENT_HOME@/memory/**)",
      "Glob(/@AGENT_HOME@/logs/**)",
      "Glob(/@AGENT_HOME@/uploads/**)",
      "Glob(/@AGENT_HOME@/*_run/**)",
      "Glob(/@AGENT_HOME@/tg/**)",
      "Glob(/@AGENT_HOME@/.venv/**)",
      "Glob(/@AGENT_HOME@/.claude-config/**)",
      "Glob(/@AGENT_HOME@/.claude-config-public/**)",
      "Glob(/@AGENT_HOME@/bin/**)",
      "Glob(/@AGENT_HOME@/prompts/**)",
      "Glob(/@AGENT_HOME@/config/**)",
      "Glob(/@AGENT_HOME@/.git/**)",
      "Glob(/@AGENT_HOME@/*.json)",
      "Glob(/@AGENT_HOME@/*.txt)",
      "Glob(/@AGENT_HOME@/*.md)",
      "Glob(/@AGENT_USER_HOME@/.claude-token.env)",
      "Glob(/@AGENT_USER_HOME@/.ssh/**)",
      "Glob(//root/**)",
      "Glob(//etc/**)"
    ]
  }
}
