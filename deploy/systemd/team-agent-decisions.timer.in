[Unit]
Description=Team agent duty timer: decisions (пн 11:00 — поставьте за час до своей встречи, пояс @TZ@)

[Timer]
OnCalendar=Mon *-*-* 11:00:00 @TZ@
# прогон, пропущенный из-за выключенного сервера, выполнится после загрузки
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
