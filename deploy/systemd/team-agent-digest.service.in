[Unit]
Description=Team agent duty: дневной дайджест рабочих Telegram-папок
After=network-online.target
Wants=network-online.target
# упавшая duty обязана сообщить о себе: тишина ≠ успех
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=@AGENT_USER@
WorkingDirectory=@AGENT_HOME@
EnvironmentFile=@AGENT_USER_HOME@/.claude-token.env
Environment=AGENT_HOME=@AGENT_HOME@
Environment=TZ=@TZ@
Environment=PATH=@AGENT_USER_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash @AGENT_HOME@/bin/run_digest.sh
# бэкстоп поверх таймаутов внутри скрипта: зависшая duty не висит вечно
TimeoutStartSec=2400
NoNewPrivileges=true
