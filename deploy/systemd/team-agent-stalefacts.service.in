[Unit]
Description=Team agent duty: факты базы, код по которым менялся после записи
After=network-online.target
Wants=network-online.target
# упавшая duty обязана сообщить о себе: тишина ≠ успех
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=@AGENT_USER@
WorkingDirectory=@AGENT_HOME@
EnvironmentFile=@AGENT_USER_HOME@/.claude-token.env
Environment=AGENT_HOME=@AGENT_HOME@
Environment=TZ=@TZ@
Environment=PATH=@AGENT_USER_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 @AGENT_HOME@/bin/stale_facts.py --notify
# бэкстоп поверх таймаутов внутри скрипта: зависшая duty не висит вечно
TimeoutStartSec=900
NoNewPrivileges=true
