# team-os-agent — конфигурация. Скопируйте в $AGENT_HOME/.env, chmod 600.
# Формат: KEY=VALUE, без пробелов вокруг «=», кавычки не нужны. Файл НЕ исполняется
# (читается построчно), поэтому спецсимволы в значениях безопасны.
# Токен подписки Claude сюда НЕ кладите — он живёт отдельно в ~/.claude-token.env
# (CLAUDE_CODE_OAUTH_TOKEN=...), см. INSTALL.md.

# --- Имена (подставляются в промпты и сообщения) ---
# Имя агента, как он представляется («Робин», «Ассистент» …)
AGENT_NAME=
# Название команды в родительном падеже или как удобно: «команды Acme», «Acme»
TEAM_NAME=
# Продукт, о котором агент отвечает: «Acme Booking»
PRODUCT_NAME=
# Кто владелец бота, в именительном падеже — подставляется в скобках: «напишите владельцу бота (руководитель продукта)»
OWNER_NAME=

# --- Telegram-бот (@BotFather) ---
# Токен бота
TG_BOT_TOKEN=
# Username бота без @ (нужен для распознавания упоминаний и реплаев в группах)
TG_BOT_USERNAME=
# Telegram user id владельца: алерты, отчёты duty, команды promote/reject
OWNER_ID=
# user id команды через запятую — полный режим (код, GitLab). Остальные — публичный режим
TEAM_IDS=
# Куда слать дайджест и VoC (id канала/группы, обычно вида -100…). Пусто = владельцу в личку
DIGEST_CHAT_ID=
# 1 = отвечать в личке всем (не-команде — публичный режим); 0 = только команде
PUBLIC_DM=1
# Если задано — бот работает только в этих группах (id через запятую). Пусто = в любых
ALLOWED_GROUP_IDS=
# Потолок ответов в сутки на всех (защита лимита подписки)
GLOBAL_DAILY_LIMIT=200
# Потолок в сутки на одного человека НЕ из команды (0 = без ограничения)
PUBLIC_USER_DAILY_LIMIT=20
# Сколько секунд после ответа в группе слушать автора без тега (нужен privacy mode OFF)
GROUP_FOLLOWUP_S=300

# --- Telegram-аккаунт для чтения папок (Telethon; my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# Путь к файлу сессии БЕЗ расширения .session (создаёт bin/tg_login.py)
TG_SESSION=/home/teamagent/.local/share/team-agent/tg/reader
# Телефон аккаунта (необязательно — tg_login.py спросит)
TG_PHONE=
# Имена папок Telegram через запятую: рабочие чаты для дневного дайджеста. Пусто = дайджест выключен
DIGEST_FOLDERS=
# Папки с клиентскими чатами для еженедельного VoC. Пусто = VoC выключен
VOC_FOLDERS=

# --- База знаний (репо team-os-knowledge или ваш форк) ---
# ssh-URL репо знаний; клонируется в $AGENT_HOME/knowledge deploy-ключом
KNOWLEDGE_REPO_URL=
# Основная ветка репо знаний
KNOWLEDGE_BRANCH=main
# Файл решений и как в нём выглядит строка статуса «ждёт вердикта» (regex awk)
DECISIONS_FILE=decisions.md
DECISIONS_PENDING_RE=(Вердикт|Статус|Status|Verdict)[^:]*:[ *]*(pending|proposed)
# Как назвать встречу в напоминании: «бэклог-встрече», «планированию»
DECISIONS_MEETING=
# Регламент brain-sync в репо знаний (если файла нет — duty работает по встроенным шагам)
BRAINSYNC_SKILL=brain/skills/update-knowledge/SKILL.md
# Куда learn-questions может писать факты (пути через пробел)
LEARN_PATHS=product/ brain/product/
QUESTIONLEARN_MIN_TURNS=10

# --- Ревью веток конвейеров (team-agent-mergereview) ---
# Какие ветки ревьюить (префиксы через пробел)
MERGEREVIEW_PREFIXES=brain-sync/ learn-questions/ ticket-learn/
# Какие файлы ветке можно трогать (regex grep -E по путям)
MERGEREVIEW_ALLOWED_RE=^(brain|product)/|^decisions\.md$
# 1 = мёржить одобренное в KNOWLEDGE_BRANCH самому. По умолчанию 0: только отчёт со ссылкой на PR
MERGEREVIEW_AUTOMERGE=0

# --- GitLab (read-only; необязательно) ---
# https://gitlab.example.com
GITLAB_URL=
# Токен с scope read_api (+ read_repository для codesync по HTTPS), роль Reporter
GITLAB_TOKEN=
# Проект с задачами: id или путь group/project
GITLAB_PROJECT=

# --- Код (необязательно) ---
# Файл со списком репо: «имя url ветка [ключевые,слова]», см. config/code-repos.txt.example
CODE_REPOS=/home/teamagent/.local/share/team-agent/config/code-repos.txt

# --- Модели ---
# Ответы людям в чате
MODEL_ANSWER=claude-opus-5-5
# Регулярные duty (дайджест, VoC, brain-sync, learn-questions)
MODEL_DUTY=claude-sonnet-5-5
# Ревьюер веток знаний (пусто = MODEL_ANSWER)
MODEL_REVIEW=
# Таймауты ответа, сек: без кода / с подключённым кодом
QUERY_TIMEOUT_S=300
QUERY_TIMEOUT_CODE_S=600

# --- Время ---
# Часовой пояс команды (IANA): Europe/Berlin, Asia/Tbilisi … Используется в промптах и duty;
# расписания таймеров install.sh рендерит в этом поясе
TZ=UTC

# --- Watchdog (teamos-watchdog, необязательно) ---
# Доп. TCP-проверки «имя=host:port» через пробел (например VPN до внутреннего GitLab)
WATCHDOG_TCP_CHECKS=
# Доп. HTTP-проверки «имя=URL» через пробел (ждём HTTP 2xx/3xx)
WATCHDOG_HTTP_CHECKS=
# Порог заполнения диска, %
WATCHDOG_DISK_PCT=85
# Если бэкап забирается на другую машину и она трогает маркер — макс. возраст маркера, часов (пусто = не проверять)
WATCHDOG_OFFSITE_MAX_H=

# =====================================================================
# --- Коннекторы к внешним системам (connectors/; подробно — connectors/README.md) ---
# Все ВЫКЛЮЧЕНЫ: пусто или 0 = выключен, 1 = включён. Выключенный коннектор не меняет
# ни промпт бота, ни поведение duty. Токены здесь — ТОЛЬКО read-only (кроме явно write).
# Модель эти переменные не видит: бот вычищает их из окружения claude, обёртки читают .env сами.
# =====================================================================

# --- Общее для обёрток ---
# Потолок вывода обёртки для модели, символов (пусто = 8000)
CONNECTOR_MAX_OUT=
# Ключи JSON, значения которых маскируются, через запятую (пусто = email, phone, first_name, last_name, address …)
CONNECTOR_PII_KEYS=

# --- logs-metrics: логи Elasticsearch/OpenSearch + метрики Prometheus (read-only) ---
CONNECTOR_LOGS_METRICS_ENABLED=
# https://logs.example.com — ES/OpenSearch или ваш прокси с серверной маскировкой PII (лучше)
LOGS_ES_URL=
# API key ES с ролью только read на индексы из allowlist (Authorization: ApiKey …). Или USER+PASSWORD
LOGS_ES_API_KEY=
LOGS_ES_USER=
LOGS_ES_PASSWORD=
# Разрешённые индексы/шаблоны через запятую, например acme-app-*,acme-nginx-*. Пусто = поиск запрещён
LOGS_INDEX_ALLOWLIST=
# Максимальное окно поиска (пусто = 7d): 15m / 6h / 7d
LOGS_MAX_WINDOW=
# Имена полей в ваших логах (пусто = @timestamp, message, level, service, trace_id)
LOGS_TIME_FIELD=
LOGS_MESSAGE_FIELD=
LOGS_LEVEL_FIELD=
LOGS_SERVICE_FIELD=
LOGS_TRACE_FIELD=
# https://metrics.example.com — Prometheus (или совместимый: VictoriaMetrics, Thanos); пусто = метрики выключены
METRICS_PROM_URL=
# Bearer-токен, если Prometheus за авторизацией
METRICS_PROM_TOKEN=

# --- product-api: REST API продукта на ТЕСТОВОМ аккаунте ---
CONNECTOR_PRODUCT_API_ENABLED=
# Базовый URL тестового стенда/аккаунта: https://sandbox-api.example.com
PRODUCT_API_URL=
# Токен ТЕСТОВОГО аккаунта (не боевого!)
PRODUCT_API_TOKEN=
# Заголовок и схема авторизации (пусто = Authorization / Bearer; схема none = голый токен, например для X-Api-Key)
PRODUCT_API_AUTH_HEADER=
PRODUCT_API_AUTH_SCHEME=
# Allowlist путей и правила записи (пусто = config/product-api.json; пример — config/product-api.example.json)
PRODUCT_API_CONFIG=
# 1 = разрешить запись (POST/PUT/DELETE) — только из лички команды, с предохранителями. Пусто = только чтение
PRODUCT_API_WRITE_ENABLED=
# Потолок записей в сутки (пусто = 10)
PRODUCT_API_WRITE_DAILY_LIMIT=
# Маркер тестовых объектов в поле marker_field (пусто = AGENT-TEST)
PRODUCT_API_TEST_MARKER=
# Автоочистка: удалять свои объекты старше N часов (пусто = 12; таймер team-agent-productapi-cleanup)
PRODUCT_API_CLEANUP_HOURS=
# Где ledger созданных объектов (пусто = memory/product-api-ledger.jsonl)
PRODUCT_API_LEDGER=
# ВНИМАНИЕ: PRODUCT_API_WRITE_CONTEXT сюда НЕ пишите — его ставит только бот для лички команды.

# --- helpdesk: закрытые тикеты → пары вопрос/ответ → duty ticket-learn ---
CONNECTOR_HELPDESK_ENABLED=
# https://<поддомен>.zendesk.com или URL вашего хелпдеска
HELPDESK_URL=
# basic (USER + TOKEN; для Zendesk USER=<email агента>/token) | bearer | header (пусто = basic)
HELPDESK_AUTH=
HELPDESK_USER=
# Read-only токен хелпдеска
HELPDESK_TOKEN=
# Имя заголовка для HELPDESK_AUTH=header (пусто = X-Api-Key)
HELPDESK_AUTH_HEADER=
# Маппинг API (пусто = config/helpdesk.json; пример с адаптерами zendesk и generic — config/helpdesk.example.json)
HELPDESK_CONFIG=
# Потолок тикетов за прогон (пусто = 300)
HELPDESK_MAX_TICKETS=
# Куда ticket-learn может писать факты в базе знаний, пути через пробел (пусто = product/)
HELPDESK_LEARN_PATHS=
# Куда слать еженедельный отчёт о болях из тикетов (id чата; пусто = владельцу в личку)
HELPDESK_REPORT_CHAT_ID=

# --- client-reports: ежедневный отчёт метрик клиенту в его чат ---
CONNECTOR_CLIENT_REPORTS_ENABLED=
# Клиент → chat_id → источник → метрики (пусто = config/client-reports.json; пример — config/client-reports.example.json)
CLIENT_REPORTS_CONFIG=
# Read-only токен источника метрик (имя переменной задаётся в source.auth_env конфига)
CLIENT_REPORTS_TOKEN=

# --- prod-digest: ежемесячный черновик «что уехало на прод» (GitLab выше: GITLAB_URL/TOKEN/PROJECT) ---
CONNECTOR_PROD_DIGEST_ENABLED=
# Лейбл, который ставят задаче при выкатке (пусто = «На проде»)
PROD_DIGEST_LABEL=

# --- eval: еженедельный eval ответов с LLM-судьёй ---
CONNECTOR_EVAL_ENABLED=
# Сколько вопросов за прогон (пусто = 10; каждый = ответ MODEL_ANSWER + вызов судьи)
EVAL_SIZE=
# Ручной набор вопросов jsonl {"question", "reference"} (пусто = свежая неделя тикетов из helpdesk)
EVAL_SET=
# Модель судьи (пусто = MODEL_DUTY)
EVAL_MODEL_JUDGE=

# --- github: конвейеры сами открывают PR в репо знаний (иначе — compare-ссылка) ---
CONNECTOR_GITHUB_ENABLED=
# Fine-grained PAT только на репо знаний: Pull requests — Read and write. Пусто = попробовать `gh` CLI
GITHUB_TOKEN=
# owner/repo, если не выводится из origin (пусто = из origin рабочей копии)
GITHUB_REPO=
# GitHub Enterprise: https://github.example.com/api/v3 (пусто = api.github.com)
GITHUB_API_URL=

# --- mcp: любые MCP-серверы для ответов команде (не для публичного режима и не для duty) ---
# Путь к конфигу серверов (относительный — от AGENT_HOME), например config/mcp.json. Пусто = MCP выключен
MCP_CONFIG=
# Белый список инструментов через запятую: mcp__<сервер>__<инструмент>. Пусто = MCP не подключается
MCP_ALLOWED_TOOLS=
# Явные запреты через запятую (поверх белого списка)
MCP_DISALLOWED_TOOLS=
# 1 = разрешить инструменты с пишущими именами (create/update/delete/send…). Пусто = отклоняются
MCP_ALLOW_WRITE_TOOLS=
